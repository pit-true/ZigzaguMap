    {"op": "clickEvent", "x": 16, "y": 16},
    {"op": "compareFields", "fields": ["field:Cbo_EventTypen", "field:Spin_Nr", "enabled:Spin_Nr", "enabled:Cmd_EventLoeschen", "field:Txt_PosX", "field:Txt_PosY"]},
    {"op": "clickEvent", "x": 6, "y": 7},
