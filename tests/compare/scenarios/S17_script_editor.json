{
  "name": "S17_script_editor",
  "title": "スクリプトエディタの選択と起動",
  "source": "S17",
  "issues": [55, 100],
  "note": "スクリプトエディタは比較テスト用の代わりの exe（scriptEditorStub）。選択のダイアログは取り消す",
  "steps": [
    {"op": "openRom"},
    {"op": "selectMap", "bank": 3, "map": 0},
    {"op": "menu", "key": ["Menue.12", "Menue.1215"]},
    {"op": "expectDialog", "present": true},
    {"op": "answerFile", "path": null},
    {"op": "expectDialog", "present": false},
    {"op": "selectTab", "tab": "event"},
    {"op": "setField", "screen": "main", "field": "Cbo_EventTypen", "value": 0},
    {"op": "setField", "screen": "main", "field": "Spin_Nr", "value": 0},
    {"op": "clickButton", "screen": "main", "button": "Cmd_Open"},
    {"op": "expectDialog", "present": false},
    {"op": "setField", "screen": "main", "field": "Cbo_EventTypen", "value": 1},
    {"op": "setField", "screen": "main", "field": "Spin_Nr", "value": 0},
    {"op": "clickButton", "screen": "main", "button": "Cmd_Open"},
    {"op": "expectDialog", "present": false}
  ]
}
