{
  "name": "S30_wild_edit",
  "title": "野生の編集と保存",
  "source": "S30",
  "issues": [70, 71],
  "note": "確率 30（300 は 255 に丸める）、枠 1 を Lv 7〜9・26 番に。保存しない編集はタイプを切り替えると消える",
  "steps": [
    {"op": "openRom"},
    {"op": "selectMap", "bank": 3, "map": 19},
    {"op": "selectTab", "tab": "wild"},
    {"op": "setField", "screen": "main", "field": "Txt_Heufigkeit", "value": 30},
    {"op": "compareFields", "fields": ["field:Cbo_Typ", "field:Txt_Heufigkeit", "field:Lbl_Heufigkeit", "enabled:Cmd_Speichern"]},
    {"op": "setField", "screen": "main", "field": "Txt_Heufigkeit", "value": 300},
    {"op": "compareFields", "fields": ["field:Cbo_Typ", "field:Txt_Heufigkeit", "field:Lbl_Heufigkeit", "enabled:Cmd_Speichern"]},
    {"op": "setField", "screen": "main", "field": "Txt_Heufigkeit", "value": 30},
    {"op": "setField", "screen": "main", "field": "Txt_Level1P1", "value": 7},
    {"op": "setField", "screen": "main", "field": "Txt_Level2P1", "value": 9},
    {"op": "setField", "screen": "main", "field": "Cbo_Pokemon1", "value": 26},
    {"op": "clickButton", "screen": "main", "button": "Cmd_Speichern"},
    {"op": "expectDialog", "present": false},
    {"op": "setField", "screen": "main", "field": "Cbo_Typ", "value": 1},
    {"op": "setField", "screen": "main", "field": "Cbo_Typ", "value": 0},
    {"op": "compareFields", "fields": ["field:Cbo_Typ", "field:Txt_Heufigkeit", "field:Lbl_Heufigkeit", "enabled:Cmd_Speichern", "field:Txt_Level1P1", "field:Txt_Level2P1", "field:Cbo_Pokemon1", "field:Txt_Level1P2", "field:Txt_Level2P2", "field:Cbo_Pokemon2"]},
    {"op": "setField", "screen": "main", "field": "Txt_Level1P2", "value": 50},
    {"op": "setField", "screen": "main", "field": "Cbo_Typ", "value": 1},
    {"op": "setField", "screen": "main", "field": "Cbo_Typ", "value": 0},
    {"op": "compareFields", "fields": ["field:Txt_Level1P1", "field:Txt_Level2P1", "field:Cbo_Pokemon1", "field:Txt_Level1P2", "field:Txt_Level2P2", "field:Cbo_Pokemon2"]},
    {"op": "selectMap", "bank": 3, "map": 0, "savePrompt": "はい", "expectedDifference": "SPEC（README「AdvanceMap と違う点」）: 未出力のまま別のマップへ移るとき、ZigzaguMap は確認を出さない。AdvanceMap は「変更を保存しますか?」を出すので「はい」（ROM へ保存）で答える（ZigzaguMap は変更を持ったまま切り替える）"},
    {"op": "selectMap", "bank": 3, "map": 19, "savePrompt": "はい", "expectedDifference": "SPEC（README「AdvanceMap と違う点」）: 未出力のまま別のマップへ移るとき、ZigzaguMap は確認を出さない。AdvanceMap は「変更を保存しますか?」を出すので「はい」（ROM へ保存）で答える（ZigzaguMap は変更を持ったまま切り替える）（野生のデータの保存の確認も同じ）"},
    {"op": "selectTab", "tab": "wild"},
    {"op": "compareFields", "fields": ["field:Cbo_Typ", "field:Txt_Heufigkeit", "field:Lbl_Heufigkeit", "enabled:Cmd_Speichern", "field:Txt_Level1P1", "field:Txt_Level2P1", "field:Cbo_Pokemon1", "field:Txt_Level1P2", "field:Txt_Level2P2", "field:Cbo_Pokemon2"]},
    {"op": "setField", "screen": "main", "field": "Txt_Heufigkeit", "value": "abc"},
    {"op": "expectDialog", "present": true, "expectedDifference": {"title": "SPEC: アプリ名と題名（Advance Map → ZigzaguMap）。整数エラーの題名は AdvanceMap のアプリの題名"}},
    {"op": "answerDialog", "button": "OK"}
  ]
}
