{
  "name": "S18_event_manager",
  "title": "イベントマネージャー（個数の変更・削除）",
  "source": "S18",
  "issues": [56],
  "note": "部品名はフォーム定義（dfm）の名前に合わせた（Txt_Anzahl→PeopNum）。人 3→5、看板 5→2、看板 1 の削除",
  "steps": [
    {"op": "openRom"},
    {"op": "selectMap", "bank": 3, "map": 0},
    {"op": "selectTab", "tab": "event"},
    {"op": "compareFields", "fields": ["field:PeopNum", "field:SignNum", "field:WarpNum", "field:ScriptNum"]},
    {"op": "setField", "screen": "main", "field": "PeopNum", "value": 5},
    {"op": "setField", "screen": "main", "field": "SignNum", "value": 2},
    {"op": "clickButton", "screen": "main", "button": "Cmd_Aendern"},
    {"op": "expectDialog", "present": false},
    {"op": "compareFields", "fields": ["field:PeopNum", "field:SignNum", "field:WarpNum", "field:ScriptNum"]},
    {"op": "snapshot", "name": "after_manager", "target": "event", "compare": {"mode": "overlayCells"}},
    {"op": "setField", "screen": "main", "field": "Cbo_EventTypen", "value": 0},
    {"op": "setField", "screen": "main", "field": "Spin_Nr", "value": 4},
    {"op": "compareFields", "fields": ["field:Cbo_EventTypen", "field:Spin_Nr", "enabled:Spin_Nr", "enabled:Cmd_EventLoeschen", "field:Spin_Bild", "field:Txt_Unbekannt1", "field:Txt_Unbekannt2", "field:Txt_PosX", "field:Txt_PosY", "field:Txt_Unbekannt3", "field:Cbo_BewTyp", "field:Txt_Bewegung", "field:Txt_Unbekannt4", "field:Chk_Trainer", "field:Txt_Unbekannt5", "field:Txt_Sichtweite", "field:Txt_Script", "field:Txt_NrStatus", "field:Txt_Unbekannt6", "field:Txt_Unbekannt7"]},
    {"op": "setField", "screen": "main", "field": "Cbo_EventTypen", "value": 1},
    {"op": "setField", "screen": "main", "field": "Spin_Nr", "value": 1},
    {"op": "compareFields", "fields": ["field:Cbo_EventTypen", "field:Spin_Nr", "enabled:Spin_Nr", "enabled:Cmd_EventLoeschen", "field:Txt_PosX", "field:Txt_PosY", "field:Cbo_AnsprechEbene", "field:Cbo_SignpostTyp", "field:Txt_Unbekannt2", "field:Txt_Unbekannt3", "field:Txt_Script"]},
    {"op": "clickButton", "screen": "main", "button": "Cmd_EventLoeschen"},
    {"op": "wait", "seconds": 1.5, "only": "zigzagu", "expectedDifference": "確認のダイアログ（#220）は消すものを調べてから出すので、出るまで待つ"},
    {"op": "answerDialog", "button": "削除", "only": "zigzagu", "expectedDifference": "ユーザーの要望（#220）: ZigzaguMap は「イベントの削除」で、消すもの（スクリプトの記述・ROM の埋める範囲）の一覧つきの確認のダイアログを出してから消す（AdvanceMap はすぐ消す）。ZigzaguMap の側だけ「削除」を押す"},
    {"op": "compareFields", "fields": ["field:Cbo_EventTypen", "field:Spin_Nr", "enabled:Spin_Nr", "enabled:Cmd_EventLoeschen", "field:PeopNum", "field:SignNum", "field:WarpNum", "field:ScriptNum"]}
  ]
}
