{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウと道具のウィンドウ（ワールドマップエディター・ブロックエディタ・パレットエディタ・ブロックパレット一括変更・スクリプトエディタ）の権限",
  "windows": [
    "main",
    "world-map",
    "block-editor",
    "palette-editor",
    "block-adjust",
    "script-editor"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-theme"
  ]
}
