+ROM_ERASE_FILE = "rom_erase.json"
+ERASE_LIMIT = 0x1000000  # maps/rom_erase.json may only erase the base ROM part (the CFRU code starts here)
+PATCH_LISTS = ("bytereplacement", "hooks", "repoints", "routinepointers", "functionrewrites")
+GENERATED_REPOINT_LIST = "generatedrepoints"
+SPECIAL_INSERTS_LIST, SPECIAL_INSERTS_BIN = "special_inserts.asm", "build/special_inserts.bin"
+
