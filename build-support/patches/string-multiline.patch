+LINE_BREAK_ESCAPES = "nplm"  # \n, \p, \l, \m: a text line ending with one of them goes on on the next line
+
+
+def ContinuesOnNextLine(line: str) -> bool:
+    """True when the text line ends with \\n, \\p, \\l or \\m (an escape, not a doubled backslash).
+    The next line, if it is a text line too, belongs to the same string (nothing is added between them)."""
+    if len(line) < 2 or line[-1] not in LINE_BREAK_ESCAPES or line[-2] != "\\":
+        return False
+    slashes = 0
+    i = len(line) - 2
+    while i >= 0 and line[i] == "\\":
+        slashes += 1
+        i -= 1
+    return slashes % 2 == 1
+
