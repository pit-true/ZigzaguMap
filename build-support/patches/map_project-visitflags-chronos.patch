+#include "defines.h"
+#include "../include/event_data.h"
+#include "../include/region_map.h"
+
+/*
+Town map visit flags (docs/MAP_PROJECT.md, ZigzaguMap #499).
+
+FR's GetMapState (0x080C47C0) and GetCaveState (0x080C4A5C) are switch statements that ask a flag for each map
+section. They are replaced here by tables of u16 flags for the sections 0x58-0xC5, so that maps/regionmap.json
+(MapVisitFlags / DungeonVisitFlags, written by ZigzaguMap) can change them: scripts/map_project.py writes the
+tables. The code reads each table through a pointer put right after the hook (repoints 080C47C8 / 080C4A64,
+inside the old functions), and map_project.py and ZigzaguMap find the tables through the same pointers.
+
+The values the functions return are the same as FR's for every section while the tables hold FR's flags
+(checked by tools/check_town_map_flags.py):
+	0xC5 (no section): SPACE; a section without a flag (0xFFFF) or outside 0x58-0xC5: ROAD;
+	otherwise ARRIVE when the flag is set, NOARRIVE when it is not.
+	The Route 4 Pokemon Center (0x63) is SPACE while Fly cannot be used (GetRegionMapPermission(3)) before its flag
+	is asked, as in FR. The condition stays when its flag is changed.
+*/
+
+#define TOWN_MAP_SECTION_FIRST 0x58
+#define TOWN_MAP_SECTION_NONE 0xC5
+#define TOWN_MAP_SECTION_COUNT (TOWN_MAP_SECTION_NONE - TOWN_MAP_SECTION_FIRST + 1)
+#define TOWN_MAP_NO_FLAG 0xFFFF
+#define TOWN_MAP_ROUTE4_POKECENTER 0x63
+#define REGION_MAP_PERMISSION_FLY 3
+
+enum
+{
+	TOWN_MAP_STATE_SPACE,
+	TOWN_MAP_STATE_ROAD,
+	TOWN_MAP_STATE_ARRIVE,
+	TOWN_MAP_STATE_NOARRIVE,
+};
+
+u8 __attribute__((long_call)) GetRegionMapPermission(u8 permission);
+
+#define TOWN_MAP_FLAG_POINTER ((const u16* const*) 0x080C47C8)
+#define TOWN_MAP_CAVE_FLAG_POINTER ((const u16* const*) 0x080C4A64)
+
+// FR's flags (0xFFFF: none). Index = map section - 0x58.
+const u16 gTownMapVisitFlags[TOWN_MAP_SECTION_COUNT] =
+{
+	[0x58 - 0x58] = 0x890, 0x891, 0x892, 0x893, 0x894, 0x895, 0x896, 0x897, 0x898, 0x899, 0x89A, // 0x58-0x62
+	[0x63 - 0x58] = 0x8A2, 0x8A3,                                                                 // 0x63-0x64
+	[0x65 - 0x58 ... 0x8E - 0x58] = TOWN_MAP_NO_FLAG,
+	[0x8F - 0x58] = 0x89B, 0x89C, 0x89D, 0x89E, 0x89F, 0x8A0, 0x8A1,                              // 0x8F-0x95
+	[0x96 - 0x58 ... 0xC5 - 0x58] = TOWN_MAP_NO_FLAG,
+};
+
+const u16 gTownMapCaveVisitFlags[TOWN_MAP_SECTION_COUNT] =
+{
+	[0x58 - 0x58 ... 0x7D - 0x58] = TOWN_MAP_NO_FLAG,
+	[0x7E - 0x58] = 0x8A4, 0x8A5, 0x8A6, 0x8A7, 0x8A8, 0x8A9, 0x8AA, 0x8AB, 0x8AC,               // 0x7E-0x86
+	                0x8AD, 0x8AE, 0x8AF, 0x8B0, 0x8B1, 0x8B2, 0x8B3, 0x8B4,                       // 0x87-0x8E
+	[0x8F - 0x58 ... 0xAD - 0x58] = TOWN_MAP_NO_FLAG,
+	[0xAE - 0x58] = 0x8B5, 0x8B6, 0x8B7, 0x8B8, 0x8B9, 0x8BA, 0x8BB, 0x8BC, 0x8BD,               // 0xAE-0xB6
+	                0x8BE, 0x8BF, 0x8C0, 0x8C1, 0x8C2,                                            // 0xB7-0xBB
+	[0xBC - 0x58 ... 0xC5 - 0x58] = TOWN_MAP_NO_FLAG,
+};
+
+static u8 TownMapFlagState(const u16* flags, u8 mapSec)
+{
+	u16 flag;
+
+	if (mapSec == TOWN_MAP_SECTION_NONE)
+		return TOWN_MAP_STATE_SPACE;
+	if (mapSec < TOWN_MAP_SECTION_FIRST || mapSec > TOWN_MAP_SECTION_NONE)
+		return TOWN_MAP_STATE_ROAD;
+
+	flag = flags[mapSec - TOWN_MAP_SECTION_FIRST];
+	if (flag == TOWN_MAP_NO_FLAG)
+		return TOWN_MAP_STATE_ROAD;
+
+	return FlagGet(flag) ? TOWN_MAP_STATE_ARRIVE : TOWN_MAP_STATE_NOARRIVE;
+}
+
+//hooks: 080C47C0 (r1)
+u8 TownMap_GetMapState(u8 mapSec)
+{
+	if (mapSec == TOWN_MAP_ROUTE4_POKECENTER
+	&&  (*TOWN_MAP_FLAG_POINTER)[mapSec - TOWN_MAP_SECTION_FIRST] != TOWN_MAP_NO_FLAG
+	&&  !GetRegionMapPermission(REGION_MAP_PERMISSION_FLY))
+		return TOWN_MAP_STATE_SPACE;
+
+	return TownMapFlagState(*TOWN_MAP_FLAG_POINTER, mapSec);
+}
+
+//hooks: 080C4A5C (r1)
+u8 TownMap_GetCaveState(u8 mapSec)
+{
+	return TownMapFlagState(*TOWN_MAP_CAVE_FLAG_POINTER, mapSec);
+}
